#!/bin/sh
# Runtime/TUN setup belongs exclusively to the service controller.
# Reloads must not hold its operation lock (configd can re-enter plugins).
if [ "${1:-}" != "--reload-only" ]; then
    /usr/local/bin/php /usr/local/opnsense/scripts/Xray/xray-service-control.php boot
    exit $?
fi
/usr/local/sbin/configctl filter reload
/usr/local/sbin/configctl interface reconfigure
